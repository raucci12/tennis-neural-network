# The raw annotated dataset -- ~19,000 images, far too large for the repo.
# Retraining requires placing your own Data folder here locally.
Data/

# Your personal test footage folder -- not meant for the repo.
# Demo videos/clips you DO want to share should live elsewhere (e.g. a
# "demos" folder) so this rule doesn't accidentally exclude them.
videos/

# Each project's isolated virtual environment -- never share these
# between projects, and never commit them (they're machine-specific)
venv/

# Python
__pycache__/
*.pyc
.DS_Store
